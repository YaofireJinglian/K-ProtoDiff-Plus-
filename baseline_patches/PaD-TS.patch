 def BMMD(x, y, kernel):
+    # Correlation features grow quadratically with input channels. Process
+    # independent features in chunks and recompute them during backward.
+    # Every feature, sample pair and kernel bandwidth is retained.
+    limit = 1024 * 1024
+    chunk = max(1, limit // (x.shape[1] * y.shape[1]))
+    if x.shape[0] <= chunk:
+        return _BMMD_dense(x, y, kernel)
+    from torch.utils.checkpoint import checkpoint
+    values = []
+    for start in range(0, x.shape[0], chunk):
+        a, b = x[start:start + chunk], y[start:start + chunk]
+        if torch.is_grad_enabled() and (a.requires_grad or b.requires_grad):
+            values.append(checkpoint(lambda u, v: _BMMD_dense(u, v, kernel),
+                                     a, b, use_reentrant=False))
+        else:
+            values.append(_BMMD_dense(a, b, kernel))
+    return torch.cat(values)
+
